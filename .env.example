# Copy to .env only if you use `docker compose`. Nova itself needs no environment variables:
# the brain, keys, voice and connectors are set in the app (Settings), and the Claude key is
# stored encrypted. Never put an API key in this file.

# Port the web preview listens on (docker compose only).
NOVA_WEB_PORT=8080

# Build-time switch: VERCEL=1 builds the web preview, whose Content Security Policy allows
# localhost so the page can reach your local Ollama. docker compose sets it for you. Leave it
# unset for the desktop installer, which keeps the strict policy.
# VERCEL=1

# Set this on the Ollama side (not read by Nova), then restart Ollama, so the web preview may
# talk to it. Use the address you open the preview at.
# OLLAMA_ORIGINS=http://localhost:8080
